# --- server ---
PORT=8000
HOST=0.0.0.0                      # must stay 0.0.0.0 for the preview proxy

# 'fake'  = scripted, key-free demo run (default)
# 'openai'= any OpenAI-compatible endpoint: OpenAI, OpenRouter, Together, Groq, vLLM, Ollama
AGENT_PROVIDER=fake

# Required when AGENT_PROVIDER=openai. Never commit the filled-in copy.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Public preview pattern; {port} is replaced with the service's port.
PREVIEW_BASE_URL=https://{port}-YOUR_SANDBOX_ID.e2b.app

# --- agent limits ---
AGENT_MAX_ITERATIONS=40
AGENT_BASH_TIMEOUT_MS=120000
AGENT_MAX_TOOL_RESULT_CHARS=24000

# --- paths ---
WORKSPACE_ROOT=workspace
DB_FILE=data/agents.db
SYSTEM_PROMPT_FILE=prompts/app-builder-system-prompt.arena.md
